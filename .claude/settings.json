{
  "permissions": {
    "allow": [
      "Bash(pkill -f \"expo start\")",
      "Bash(node -e ' *)",
      "Bash(git commit -m ' *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8081)",
      "Bash(curl -s http://localhost:8081)",
      "Bash(cmd.exe /c start http://localhost:8081)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.js\""
          }
        ]
      }
    ]
  }
}
